# Copy to `deploy/.env` and fill in. Compose reads it from beside the compose file.
# Nothing here is a secret except the operator token; no credential ever belongs in
# this file, in an image or in the repository.

# --- what runs ------------------------------------------------------------

# Hearth's own image, by digest. Build it with `deploy/Dockerfile` after `make check`,
# push it somewhere, and pin what came back -- a tag is a name that can be moved.
HEARTH_IMAGE=registry.example/hearth/hearth@sha256:...
# The sandbox image, by digest. `HEARTH_SANDBOX_IMAGE` refuses anything else, and the
# store pins the first digest it is started on: a different one refuses
# `sandbox_image_changed` until an operator upgrades deliberately.
HEARTH_SANDBOX_IMAGE=registry.example/hearth/sandbox@sha256:...

# --- who runs it ----------------------------------------------------------

# The uid the sandbox image was built for (`--build-arg HEARTH_UID`). Every sandbox
# runs as this uid, which is what keeps the bridge's peer-credential check meaningful
# across the boundary; an image built for one uid and run as another fails every
# Claude session in it.
HEARTH_UID=1000
# The group that owns the runtime socket on this host: `getent group docker | cut -d: -f3`
# on most Linux hosts, `0` on Docker Desktop, where the socket is root:root inside a
# container.
HEARTH_DOCKER_GID=999
# At least 16 characters, and this host's own. `python -c 'import secrets;
# print(secrets.token_urlsafe(32))'`
HEARTH_OPERATOR_TOKEN=

# --- where things are -----------------------------------------------------

# The daemon's data root, if it is not the default. Every volume is mounted at the
# path it has on the host, because the daemon resolves the paths Hearth hands it.
# `docker info --format '{{.DockerRootDir}}'` says what this host uses.
HEARTH_VOLUME_ROOT=/var/lib/docker/volumes
# The runtime socket, if it is not the default -- a rootless installation's is
# `/run/user/<uid>/docker.sock`. Name the same socket in HEARTH_SANDBOX_DOCKER_HOST,
# because the client Hearth runs is given a search path and nothing else and cannot
# inherit `DOCKER_HOST`.
HEARTH_DOCKER_SOCKET=/var/run/docker.sock
HEARTH_SANDBOX_DOCKER_HOST=
# Where Hearth answers. The default publishes to the loopback only; a household
# reached from other machines belongs behind a reverse proxy that terminates TLS.
HEARTH_BIND=127.0.0.1
HEARTH_PORT=8000

# --- the fence ------------------------------------------------------------

# Measured from inside `hearth-egress` at every start and on every `GET /api/health`.
# Anything but "the provider and nothing else" refuses `sandbox_network_open` and the
# instance does not open. `deploy/fence.sh` installs the filter that makes it hold.
#
# SHUT: addresses a session must NOT reach. Name at least two -- Hearth's own address
# on its own network (fixed by the compose file, so it survives restarts) and one
# address on this LAN that really answers, because an address nothing listens on
# proves nothing about a fence.
HEARTH_SANDBOX_SHUT=172.30.0.2:8000,192.168.1.1:80
# OPEN: the provider host a session must reach, or its sessions cannot work.
HEARTH_SANDBOX_OPEN=chatgpt.com:443
# The two networks' subnets, if these collide with something on this host. The fence
# filter is keyed to the second one.
HEARTH_SUBNET=172.30.0.0/24
HEARTH_EGRESS_SUBNET=172.31.240.0/24
HEARTH_ADDRESS=172.30.0.2

# --- the providers --------------------------------------------------------

# The pinned CLIs, on the `hearth-binaries` volume: the same Linux builds the sandbox
# image was built from, because the image's own copies are hashed against the store's
# pin at every start. Leave a provider's pair empty if this household does not use it;
# the store's own default runtime must have both.
HEARTH_CODEX_BINARY=/var/lib/docker/volumes/hearth-binaries/_data/codex
HEARTH_CLAUDE_BINARY=/var/lib/docker/volumes/hearth-binaries/_data/claude
# The household's logins, on the `hearth-credentials` volume, one directory per
# provider, seeded with that CLI's own login flow and never by Hearth. A resident's
# own login lives under the store instead, at `<data>/credentials/<id>/<kind>/`.
HEARTH_CODEX_AUTH_HOME=/var/lib/docker/volumes/hearth-credentials/_data/codex_subscription
HEARTH_CLAUDE_CONFIG_DIR=/var/lib/docker/volumes/hearth-credentials/_data/claude_subscription
